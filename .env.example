# PowerShell: set these in the process environment before starting the backend (uvicorn).
# Omit AGENT_API_TOKEN to generate data/runtime/api-token on first start.
# AGENT_API_TOKEN=<at-least-24-random-characters>
OLLAMA_URL=http://127.0.0.1:11434
REASONING_MODEL=qwen-9b-reasoning
CODING_MODEL=qwen-9b-reasoning
SECURITY_MODEL=qwen3.8-heretic-q4
VISION_MODEL=minicpm-v:latest
CONTEXT_TOKENS=4096
OUTPUT_TOKENS=768
MODEL_TIMEOUT=120
QUEUE_TIMEOUT=30
# AGENT_WORKSPACE=D:/your-approved-workspace
# AGENT_DATA_DIR=D:/your-private-agent-data
# PENTEST_LAB_TARGETS=[{"id":"my-lab","label":"Lab lokal","host":"127.0.0.1","ports":[8080]}]
AGENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null
